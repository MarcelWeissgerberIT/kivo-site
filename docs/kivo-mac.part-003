# === Variables set by configure
VERSION=	3.12
srcdir=		.

abs_srcdir=	/private/tmp/tmpeq32q37d/Python-3.12.14
abs_builddir=	/private/tmp/tmpeq32q37d/Python-3.12.14


CC=		clang
CXX=		clang++
LINKCC=		$(PURIFY) $(CC)
AR=		/tmp/tmpeq32q37d/tools/llvm/bin/llvm-ar
READELF=	@READELF@
SOABI=		cpython-312-darwin
LDVERSION=	$(VERSION)$(ABIFLAGS)
LIBPYTHON=	
GITVERSION=	
GITTAG=		
GITBRANCH=	
PGO_PROF_GEN_FLAG=-fprofile-instr-generate
PGO_PROF_USE_FLAG=-fprofile-instr-use="$(shell pwd)/code.profclangd"
LLVM_PROFDATA=/tmp/tmpeq32q37d/tools/llvm/bin/llvm-profdata
LLVM_PROF_MERGER= /tmp/tmpeq32q37d/tools/llvm/bin/llvm-profdata merge -output="$(shell pwd)/code.profclangd" "$(shell pwd)"/*.profclangr 
LLVM_PROF_FILE=LLVM_PROFILE_FILE="$(shell pwd)/code-%128m.profclangr"
LLVM_PROF_ERR=no
LLVM_MERGED_DATA_FILE=$(shell pwd)/code.profclangd
DTRACE=         
DFLAGS=         
DTRACE_HEADERS= 
DTRACE_OBJS=    
