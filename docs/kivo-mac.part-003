__author__ = "Eric Larson"
__email__ = "eric@ionrock.org"
# pip patch: this won't work when vendored, so just patch it out as it's unused
# __version__ = importlib.metadata.version("cachecontrol")

__all__ = [
    "__author__",
    "__email__",
    "__version__",
    "CacheControlAdapter",
    "CacheController",
    "CacheControl",
]

